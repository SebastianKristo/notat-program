{
  "name": "marg",
  "productName": "Marg",
  "version": "1.0.0",
  "description": "Marg – privat skrive- og notatapp",
  "author": "Sebastian Kristo",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:mac": "vite build && electron-builder --mac dmg --universal --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "no.kristo.marg",
    "productName": "Marg",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "identity": null
    },
    "dmg": {
      "artifactName": "Marg-${version}-mac.dmg"
    },
    "directories": {
      "output": "release"
    }
  }
}

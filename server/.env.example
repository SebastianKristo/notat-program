# Alt her er valgfritt. Ollama-adresse og modell settes i appen under Innstillinger.
# Domene for HTTPS (f.eks. notes.kristo.no). Standard er http på port 80.
DOMAIN=:80
POSTGRES_PASSWORD=bytt-meg-til-noe-langt
# true = alle kan registrere seg. Første bruker blir administrator.
ALLOW_SIGNUP=false
# Hvor repoet ligger på verten (brukes av oppdateringstjenesten)
MARG_DIR=/opt/marg
# Bare for Ollama i Docker (--profile ollama):
OLLAMA_MODELS=llama3.1:8b nomic-embed-text

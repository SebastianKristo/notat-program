DOMAIN=notes.kristo.no
POSTGRES_PASSWORD=bytt-meg-til-noe-langt
# true = alle kan registrere seg. Første bruker kan alltid registrere seg.
ALLOW_SIGNUP=false
# Ekstern Ollama (Mac mini e.l.). Mac-en må lytte på nettverket: launchctl setenv OLLAMA_HOST 0.0.0.0
OLLAMA_URL=http://mac-mini.local:11434
# Brukes hvis appen ber om en modell som ikke finnes på Ollama-serveren
OLLAMA_DEFAULT_MODEL=
# Bare for lokal Ollama (--profile ollama):
OLLAMA_MODELS=llama3.1:8b qwen2.5:14b nomic-embed-text
